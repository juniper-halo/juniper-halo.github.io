---
import { site } from '../data/site';
import { url } from '../lib/url';
---

<nav class="nav glass" aria-label="Sections">
  <a class="brand" href="#top">{site.handle} ~/portfolio</a>
  <div class="links">
    <a href="#log">experience</a>
    <a href="#projects">projects</a>
    <a href="#reading">reading</a>
    <a class="cv" href={url(site.cvPdf)}>cv.pdf</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 16px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding: 8px 8px 8px 22px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .brand {
    color: var(--accent);
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--text);
  }
  .links a.cv {
    color: var(--bg);
    background: var(--accent);
    padding: 10px 18px;
    border-radius: 999px;
  }
  .links a.cv:hover {
    background: var(--accent-hover);
  }
  @media (max-width: 640px) {
    .nav {
      border-radius: 20px;
      padding: 8px 8px 8px 16px;
    }
    .links {
      gap: 4px 14px;
    }
    .links a:not(.cv) {
      padding: 8px 0;
    }
  }
</style>
